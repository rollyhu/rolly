pragma solidity ^0.8;


contract NFTAuction {
 
    //结构体
    struct Auction {
        //竞价者
        address seller;
        //拍卖持续时间
        uint256 duration;
        //起始价格
        uint256 startPrice;
        //是否结束
        bool ende;
        //最高出价者
        address highestBidder;
        //最高价格
        uint256 highestBid;
        //开始时间
        uint256 startTime;
        //NFT合约地址
        address nftContract;
        //NFTID
        uint256 tokenId;
    }


    //状态变量
    mapping (uint256 => Auction) auctions;
    //下一个ID
    uint256 public nextAuctionId;
    //管理员地址
    address public admin;
    
    constructor() {
        admin = msg.sender;
    }
    
    //创建拍卖
    function createAuction(uint256 _duration,uint256 _startPrice,address _nftContract,uint256 tokenId) public{
        require(msg.sender==admin," must  only admin createAuction");
        require(_duration>1000*60,"_duration must be greater than 1000*60");
        require(_startPrice>0,"_startPrice must be greater than 0");
        auctions[nextAuctionId] = Auction({
            seller:msg.sender,
            duration:1000*100,
            startPrice:100000,
            ende:false,
            highestBidder:address(0),
            highestBid:0,
            startTime:block.timestamp,
            nftContract:_nftContract,
            tokenId:tokenId

        });
        nextAuctionId++;
    }

    //买家参与竞价
    function placeBid(uint256 _auctionId) external payable{
        Auction storage auction = auctions[_auctionId];
        require(!auction.ende,"auction has ended");
        require(block.timestamp<auction.startTime+auction.duration,"auction has ended");
        require(msg.value>auction.highestBid,"bid must be greater than highestBid");
        //退回之前最高价格者
        if(auction.highestBidder!=address(0)){
            payable(auction.highestBidder).transfer(auction.highestBid);
        }
        auction.highestBidder = msg.sender;
        auction.highestBid = msg.value;
    }
}
